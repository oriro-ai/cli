{
  "name": "@oriro/qianfan-provider",
  "version": "2026.6.8",
  "description": "Oriro Qianfan provider plugin.",
  "repository": {
    "type": "git",
    "url": "https://github.com/oriro-ai/cli"
  },
  "type": "module",
  "devDependencies": {
    "@oriro/plugin-sdk": "workspace:*"
  },
  "oriro": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "orirohubSpec": "orirohub:@oriro/qianfan-provider",
      "npmSpec": "@oriro/qianfan-provider",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.6.8"
    },
    "compat": {
      "pluginApi": ">=2026.6.8"
    },
    "build": {
      "oriroVersion": "2026.6.8",
      "bundledDist": false
    },
    "release": {
      "publishToOriroHub": true,
      "publishToNpm": true
    }
  }
}
