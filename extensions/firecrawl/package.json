{
  "name": "@oriro/firecrawl-plugin",
  "version": "2026.6.9",
  "description": "ORIRO Firecrawl plugin.",
  "repository": {
    "type": "git",
    "url": "https://github.com/oriro/oriro"
  },
  "type": "module",
  "dependencies": {
    "typebox": "1.1.39"
  },
  "devDependencies": {
    "@oriro/plugin-sdk": "workspace:*"
  },
  "oriro": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "orirohubSpec": "orirohub:@oriro/firecrawl-plugin",
      "npmSpec": "@oriro/firecrawl-plugin",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.6.8"
    },
    "compat": {
      "pluginApi": ">=2026.6.9"
    },
    "build": {
      "oriroVersion": "2026.6.9",
      "bundledDist": false
    },
    "release": {
      "publishToOriroHub": true,
      "publishToNpm": true
    }
  }
}
