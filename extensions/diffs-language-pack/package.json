{
  "name": "@oriro/diffs-language-pack",
  "version": "2026.6.9",
  "description": "ORIRO diffs viewer syntax highlighting language pack",
  "repository": {
    "type": "git",
    "url": "https://github.com/oriro/oriro"
  },
  "type": "module",
  "devDependencies": {
    "@oriro/plugin-sdk": "workspace:*"
  },
  "oriro": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@oriro/diffs-language-pack",
      "orirohubSpec": "orirohub:@oriro/diffs-language-pack",
      "localPath": "extensions/diffs-language-pack",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.27"
    },
    "compat": {
      "pluginApi": ">=2026.6.9"
    },
    "assetScripts": {
      "build": "node ../../scripts/build-diffs-viewer-runtime.mjs full"
    },
    "build": {
      "oriroVersion": "2026.6.9",
      "staticAssets": [
        {
          "source": "./assets/viewer-runtime.js",
          "output": "assets/viewer-runtime.js"
        }
      ]
    },
    "release": {
      "publishToOriroHub": true,
      "publishToNpm": true
    }
  }
}
