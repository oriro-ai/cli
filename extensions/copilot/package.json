{
  "name": "@oriro/copilot",
  "version": "2026.6.8",
  "description": "Oriro GitHub Copilot agent runtime plugin (registers a `github-copilot` AgentHarness backed by @github/copilot-sdk over JSON-RPC to the GitHub Copilot CLI)",
  "repository": {
    "type": "git",
    "url": "https://github.com/oriro-ai/cli"
  },
  "type": "module",
  "dependencies": {
    "@github/copilot-sdk": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@github/copilot": "1.0.55",
    "@oriro/plugin-sdk": "workspace:*"
  },
  "oriro": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "orirohubSpec": "orirohub:@oriro/copilot",
      "npmSpec": "@oriro/copilot",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.28"
    },
    "compat": {
      "pluginApi": ">=2026.6.8"
    },
    "build": {
      "oriroVersion": "2026.6.8",
      "bundledDist": false
    },
    "release": {
      "bundleRuntimeDependencies": false,
      "publishToOriroHub": true,
      "publishToNpm": true
    }
  }
}
