// Default signing values for shared/repo builds.
// Auto-selected local team overrides live in .local-signing.xcconfig (git-ignored).
// Manual local overrides can go in LocalSigning.xcconfig (git-ignored).

#include "Config/Version.xcconfig"

ORIRO_CODE_SIGN_STYLE = Manual
ORIRO_CODE_SIGN_IDENTITY = Apple Development
ORIRO_DEVELOPMENT_TEAM = FWJYW4S8P8

ORIRO_APP_BUNDLE_ID = ai.orirofoundation.app
ORIRO_SHARE_BUNDLE_ID = ai.orirofoundation.app.share
ORIRO_APP_GROUP_ID = group.ai.orirofoundation.app.shared
ORIRO_WATCH_APP_BUNDLE_ID = ai.orirofoundation.app.watchkitapp
ORIRO_ACTIVITY_WIDGET_BUNDLE_ID = ai.orirofoundation.app.activitywidget
ORIRO_APNS_ENTITLEMENT_ENVIRONMENT = development

ORIRO_APP_PROFILE = ai.orirofoundation.app Development
ORIRO_SHARE_PROFILE = ai.orirofoundation.app.share Development
ORIRO_ACTIVITY_WIDGET_PROFILE =
ORIRO_WATCH_APP_PROFILE =

// Keep local includes after defaults: xcconfig is evaluated top-to-bottom,
// so later assignments in local files override the defaults above.
#include? ".local-signing.xcconfig"
#include? "LocalSigning.xcconfig"
