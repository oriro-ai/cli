{
  "name": "@oriro/google-meet",
  "version": "2026.6.9",
  "description": "ORIRO Google Meet participant plugin for joining calls through Chrome or Twilio transports.",
  "repository": {
    "type": "git",
    "url": "https://github.com/oriro/oriro"
  },
  "type": "module",
  "dependencies": {
    "commander": "14.0.3",
    "typebox": "1.1.39"
  },
  "devDependencies": {
    "@oriro/plugin-sdk": "workspace:*",
    "oriro": "workspace:*"
  },
  "peerDependencies": {
    "oriro": "workspace:*"
  },
  "peerDependenciesMeta": {
    "oriro": {
      "optional": true
    }
  },
  "oriro": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@oriro/google-meet",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.20"
    },
    "compat": {
      "pluginApi": ">=2026.6.9"
    },
    "build": {
      "oriroVersion": "2026.6.9"
    },
    "release": {
      "publishToOriroHub": true,
      "publishToNpm": true
    }
  }
}